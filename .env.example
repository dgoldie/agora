# Copy to .env and fill in values. Never commit .env.
# .env is loaded by `source .env` or a tool like direnv.

# Phoenix
SECRET_KEY_BASE=                  # mix phx.gen.secret
PHX_HOST=localhost
PORT=4000

# Database (prod only — dev uses config/dev.exs)
DATABASE_URL=ecto://USER:PASS@HOST/agora_prod

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# S3 / R2 for file uploads
S3_BUCKET=agora-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mailer (prod only)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
